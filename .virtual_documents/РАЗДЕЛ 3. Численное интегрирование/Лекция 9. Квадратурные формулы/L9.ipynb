def rect_left(f, a, b, n):
    h = (b - a) / n
    return h * f(np.linspace(a, b - h, n)).sum()

def rect_right(f, a, b, n):
    h = (b - a) / n
    return h * f(np.linspace(a + h, b, n)).sum()

def rect_mid(f, a, b, n):
    h = (b - a) / n
    return h * f(a + h * (np.arange(n) + 0.5)).sum()

